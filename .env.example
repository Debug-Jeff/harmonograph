# Gallery storage. Leave unset in local dev to use a JSON file in .data/.
# Any Postgres URL works — Neon or Supabase both provide one.
DATABASE_URL=

# Salt for hashing client IPs in the save rate limiter. Any random string.
RATE_LIMIT_SALT=

# Only for the Tauri (static) build: where the hosted gallery API lives.
NEXT_PUBLIC_GALLERY_ORIGIN=
